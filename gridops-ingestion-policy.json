{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndWriteServingDemand",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:818007713988:table/gridops-demand-serving"
    },
    {
      "Sid": "ArchiveRawEIA",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::gridops-raw-8f3c1a7d/*"
    }
  ]
}
