{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadServingDemand",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query",
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:818007713988:table/gridops-demand-serving"
    },
    {
      "Sid": "ReadProductionModels",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::gridops-raw-8f3c1a7d/models/production/*"
    }
  ]
}
